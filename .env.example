# Schwab OAuth credentials (obtain from https://developer.schwab.com/)
SCHWAB_APP_KEY=your_app_key_here
SCHWAB_APP_SECRET=your_app_secret_here
SCHWAB_CALLBACK_URL=https://127.0.0.1/callback

# OAuth tokens (populated after first authorization)
SCHWAB_ACCESS_TOKEN=
SCHWAB_REFRESH_TOKEN=

# Optional: override API base URLs (for testing)
# SCHWAB_TRADER_BASE_URL=https://api.schwabapi.com/trader/v1
# SCHWAB_MARKET_DATA_BASE_URL=https://api.schwabapi.com/marketdata/v1
